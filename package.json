{
  "name": "sendcloud-frontend-test",
  "version": "1.0.0",
  "description": "Sendcloud - frontend test",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "start": "concurrently \"npm:mock-backend\" \"npm:dev\"",
    "dev": "vite",
    "build": "vite build",
    "prepreview": "npm run build",
    "preview": "concurrently \"npm:mock-backend\" \"vite preview\"",
    "test": "vitest",
    "test-ui": "npx playwright test --ui",
    "generate-ui-tests": "concurrently -k \"npm start\" \"wait-on http://localhost:5173/part-1/new-shipment.html && playwright codegen http://localhost:5173/part-1/new-shipment.html\"",
    "typecheck": "tsc --noEmit",
    "mock-backend": "mockoon-cli start --faker-locale nl --data api/shipment-api-mockoon.json",
    "api-docs": "redocly preview --project-dir=./api --product=redoc",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "author": "Sendcloud",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mockoon/cli": "9.9.0",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "2.67.1",
    "axe-core": "4.14.0",
    "concurrently": "10.0.6",
    "happy-dom": "21.0.4",
    "jsdom": "29.1.1",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "@faker-js/faker": "10.6.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "handlebars": "4.7.10"
  }
}
